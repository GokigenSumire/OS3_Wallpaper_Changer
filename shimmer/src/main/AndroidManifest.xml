<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="personal.wallpaper.os4.e1" />
        <package android:name="personal.wallpaper.os4.e1.debug" />
    </queries>

    <uses-feature android:name="android.software.live_wallpaper" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".p0.P0Application"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/p0_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OS3.P0"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".p10.capability.CapabilityActivity" android:exported="false" />
        <service android:name=".p10.input.LockCommandHostService" android:exported="true" />
        <activity android:name=".p10.editor.LockEditEntryActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="personal.wallpaper.os3.lock.edit"
            android:theme="@style/Theme.OS3.LockEdit" android:screenOrientation="nosensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <activity android:name=".p10.editor.LockEditActivity" android:exported="false"
            android:excludeFromRecents="true" android:taskAffinity="personal.wallpaper.os3.lock.edit"
            android:theme="@style/Theme.OS3.LockEdit" android:screenOrientation="nosensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density" />
        <activity
            android:name=".p2.P2PlaybackActivity"
            android:exported="false" />
        <activity
            android:name=".p0.P0DiagnosticsActivity"
            android:exported="true"
            android:theme="@style/Theme.OS3.P0" />
        <activity
            android:name=".p1.P1SourcesActivity"
            android:exported="false"
            android:theme="@style/Theme.OS3.P0" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.FolderSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.FolderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.NextImageShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OS3.P0" />
        <activity
            android:name=".ui.RandomDuotoneShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OS3.P0" />
        <activity
            android:name=".ui.AddToFavoritesShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OS3.P0" />

        <activity
            android:name=".ui.ShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.OS3.P0">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <activity android:name=".p0.P0EditActivity" android:exported="false"
            android:launchMode="singleTop" android:taskAffinity="personal.wallpaper.os3.p0.edit"
            android:theme="@style/Theme.OS3.P0" />
        <activity android:name=".p0.P0SurfaceLabActivity" android:exported="false"
            android:theme="@style/Theme.OS3.P0" />
        <!-- P4 schedule settings and diagnostics: opened from the P2 page only. -->
        <activity
            android:name=".p4.P4ScheduleActivity"
            android:exported="false"
            android:theme="@style/Theme.OS3.P0" />
        <!-- P5 transition settings and diagnostics: opened from the P2 page only. -->
        <activity
            android:name=".p5.P5TransitionActivity"
            android:exported="false"
            android:theme="@style/Theme.OS3.P0" />
        <!-- P3 editor: never exported; its own task so leaving it returns to the launcher. -->
        <activity
            android:name=".p3.P3EditActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="personal.wallpaper.os3.p3.edit"
            android:excludeFromRecents="true"
            android:screenOrientation="nosensor"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:theme="@style/Theme.OS3.P3Edit" />

        <service
            android:name=".p0.P0WallpaperService"
            android:label="@string/app_name_p0"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

        <service
            android:name=".ShimmerWallpaperService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_p2" />
        </service>

        <service android:name=".p10.LockWallpaperService"
            android:label="@string/p10_lock_wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_lock" />
        </service>

        <service android:name=".p10.capability.HomeCapabilityWallpaperService"
            android:label="@string/p10_home_capability_name"
            android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_p10_home_capability" />
        </service>
        <service android:name=".p10.capability.LockCapabilityWallpaperService"
            android:label="@string/p10_lock_capability_name"
            android:permission="android.permission.BIND_WALLPAPER" android:exported="true">
            <intent-filter><action android:name="android.service.wallpaper.WallpaperService" /></intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper_p10_lock_capability" />
        </service>

    </application>

</manifest>
