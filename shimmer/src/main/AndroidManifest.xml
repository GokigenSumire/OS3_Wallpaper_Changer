<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.live_wallpaper" />

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:name=".p0.P0Application"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/p0_data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.OS3.P0">
        <activity
            android:name=".p0.P0DiagnosticsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.FolderSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".ui.settings.FolderDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.NextImageShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OS3.P0" />
        <activity
            android:name=".ui.RandomDuotoneShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OS3.P0" />
        <activity
            android:name=".ui.AddToFavoritesShortcutActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.OS3.P0" />

        <activity
            android:name=".ui.ShareActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.OS3.P0">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity android:name=".p0.P0EditActivity" android:exported="false"
            android:launchMode="singleTop" android:theme="@style/Theme.OS3.P0" />
        <activity android:name=".p0.P0SurfaceLabActivity" android:exported="false"
            android:theme="@style/Theme.OS3.P0" />

        <service
            android:name=".p0.P0WallpaperService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_WALLPAPER"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>

    </application>

</manifest>
